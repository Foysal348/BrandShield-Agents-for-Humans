# BrandShield runs locally with deterministic scoring by default.
BRANDSHIELD_DEMO_MODE=true
BRANDSHIELD_DATA_DIR=data
BRANDSHIELD_DB_PATH=artifacts/brandshield.db

# Optional: only required for the Strands + Amazon Bedrock narrative feature.
AWS_REGION=us-east-1
AWS_PROFILE=
BEDROCK_MODEL_ID=us.amazon.nova-lite-v1:0
